<Window x:Class="wpf1erprograma.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="470" Width="935"
        Background="#0E0F12"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ======= Fondo con grid sutil (como tu imagen) ======= -->
        <DrawingBrush x:Key="GridBackgroundBrush" TileMode="Tile" Viewport="0,0,48,48"
                      ViewportUnits="Absolute" Opacity="0.35" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#0E0F12" Geometry="M0,0 H48 V48 H0 Z"/>
                    <GeometryDrawing Brush="#1B1C21">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="16,0" EndPoint="16,48"/>
                                <LineGeometry StartPoint="32,0" EndPoint="32,48"/>
                                <LineGeometry StartPoint="0,16" EndPoint="48,16"/>
                                <LineGeometry StartPoint="0,32" EndPoint="48,32"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#23242A">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                                <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <SolidColorBrush x:Key="CardBg" Color="#121318"/>
        <SolidColorBrush x:Key="CardStroke" Color="#2A2B33"/>
        <SolidColorBrush x:Key="TextMain" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A9A9A9"/>
        <SolidColorBrush x:Key="Accent" Color="#2A5BD7"/>
        <SolidColorBrush x:Key="TrackOff" Color="#1E2026"/>
        <SolidColorBrush x:Key="TrackOn" Color="#2A5BD7"/>

        <!-- ======= Card ======= -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- ======= Botón moderno ======= -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#1A1C22"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22242B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15171C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======= Toggle tipo switch + texto ======= -->
        <Style x:Key="ModernSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Track"
                                    Width="46" Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="11"
                                    Background="{StaticResource TrackOff}"
                                    BorderBrush="#2A2B33"
                                    BorderThickness="1"/>

                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="#CFCFCF"/>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Content}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#24262E"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource TrackOn}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>

    </Window.Resources>

    <!-- Fondo -->
    <Grid Background="{StaticResource GridBackgroundBrush}" Margin="14">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource CardStyle}" Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Selector de señales" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- ✅ Ahora NO hay Click: usa Command + texto bind -->
                <Button Grid.Column="1"
                        x:Name="BtnAll"
                        Content="{Binding ToggleAllText}"
                        Width="160"
                        Height="36"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding ToggleAllCommand}"
                        Margin="0,2,0,0"/>
            </Grid>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Seleccionador" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <!-- ✅ En vez de 24 ToggleButton escritos a mano:
                             ItemsControl + UniformGrid.
                             Se alimenta de MainViewModel.Lines -->
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="8" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- ✅ IsChecked bind a la propiedad IsOn del LineVm -->
                                    <ToggleButton Content="{Binding Label}"
                                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  Style="{StaticResource ModernSwitchStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
