<Window x:Class="TuApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Botones desde DXF" Width="1100" Height="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="10">
            <Button Content="Abrir DXF" Click="OpenDxf_Click" Width="120" Height="32" Margin="0,0,10,0"/>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="BtnCanvas" Width="2000" Height="1200" Background="#1E1E1E"/>
        </ScrollViewer>
    </Grid>
</Window>
